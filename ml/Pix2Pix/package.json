{
  "name": "pix2pix-video",
  "version": "1.0.0",
  "private": true,
  "description": "A narrated 16:9 explainer video about the Pix2Pix architecture (U-Net + PatchGAN + cGAN/L1 loss), built with Remotion (React)",
  "scripts": {
    "train": "node scripts/train-pix2pix.mjs",
    "gradcheck": "node scripts/train-pix2pix.mjs --gradcheck",
    "voiceover": "node scripts/voiceover.mjs",
    "studio": "remotion studio",
    "render": "remotion render Pix2PixExplainer out/pix2pix-explainer.mp4",
    "still": "remotion still Pix2PixExplainer out/thumbnail.png --frame=420"
  },
  "dependencies": {
    "@remotion/cli": "4.0.534",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.534"
  },
  "devDependencies": {
    "@types/react": "19.1.8",
    "typescript": "5.8.3"
  }
}
