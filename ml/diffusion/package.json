{
  "name": "diffusion-video",
  "version": "1.0.0",
  "private": true,
  "description": "A narrated 16:9 explainer video about diffusion models (DDPM, U-Net noise predictor, DDIM, classifier-free guidance, latent diffusion), built with Remotion (React)",
  "scripts": {
    "train": "node scripts/train-diffusion.mjs",
    "voiceover": "node scripts/voiceover.mjs",
    "studio": "remotion studio",
    "render": "remotion render DiffusionExplainer out/diffusion-explainer.mp4",
    "still": "remotion still DiffusionExplainer out/thumbnail.png --frame=60"
  },
  "dependencies": {
    "@remotion/cli": "4.0.534",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.534"
  },
  "devDependencies": {
    "@types/react": "19.1.8",
    "typescript": "5.8.3"
  }
}
