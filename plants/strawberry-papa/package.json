    "still": "remotion still StrawberrySeeds out/thumbnail.png --frame=150"
  },
  "dependencies": {
    "@remotion/cli": "4.0.534",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.534"
  },
  "devDependencies": {
    "@types/react": "19.1.8",
    "sharp": "0.34.3",
    "typescript": "5.8.3"
  }
}
