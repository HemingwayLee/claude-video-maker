{
  "name": "strawberry-papa-video",
  "version": "1.0.0",
  "private": true,
  "description": "A narrated 9:16 cartoon video about where a strawberry's seeds are, built with Remotion (React)",
  "scripts": {
    "papa": "node scripts/cut-papa.mjs",
    "voiceover": "node scripts/voiceover.mjs",
    "studio": "remotion studio",
